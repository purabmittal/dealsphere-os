# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-side ONLY. Never expose to the client or commit this.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by db:seed script
SUPABASE_DB_URL=

# AI provider key (used from Phase 6 onward - server-side only)
AI_API_KEY=

# Base URL of the deployed app, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
